rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event banners: publicly viewable, writable by authenticated users
    match /events/{eventId}/banner/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Default catch-all
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
